{
  "name": "dsh-review-vscode",
  "displayName": "dsh review — inline diff + dsh sidebar",
  "description": "Inline review (shadow/pending) + dsh webview sidebar",
  "version": "0.1.86",
  "publisher": "dsn",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dsh",
    "review",
    "diff",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:dshReview.dshWebview"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dshReview.openDshSidebar",
        "category": "dsh",
        "title": "打开 / 切换 dsh 侧栏"
      },
      {
        "command": "dshReview.restartDsh",
        "icon": "$(debug-restart)",
        "category": "dsh",
        "title": "重启 dsh"
      },
      {
        "command": "dshReview.restartDshProxy",
        "icon": {
          "light": "media/dsh-refresh-proxy.svg",
          "dark": "media/dsh-refresh-proxy.svg"
        },
        "category": "dsh",
        "title": "重启 dsh（走代理）"
      },
      {
        "command": "dshReview.stopDsh",
        "icon": "$(debug-stop)",
        "category": "dsh",
        "title": "停止 dsh"
      },
      {
        "command": "dshReview.killDshJob",
        "category": "dsh",
        "title": "停止 dsh 后台任务"
      },
      {
        "command": "dshReview.browserComment.status",
        "category": "dsh",
        "title": "元素批注：看页面连接状态"
      },
      {
        "command": "dshReview.dumpDocs",
        "category": "dsh",
        "title": "排障：列出当前打开的文档"
      },
      {
        "command": "dshReview.sendSelectionToDsh",
        "category": "dsh",
        "title": "把选中的代码发给 dsh"
      },
      {
        "command": "dshReview.sendTerminalSelectionToDsh",
        "category": "dsh",
        "title": "把终端选中的内容发给 dsh"
      },
      {
        "command": "dshReview.sendFileToDsh",
        "category": "dsh",
        "title": "插入文件到 dsh 输入框"
      },
      {
        "command": "dshReview.acceptAll",
        "icon": {
          "light": "media/dsh-accept.svg",
          "dark": "media/dsh-accept.svg"
        },
        "category": "dsh",
        "title": "全部接受"
      },
      {
        "command": "dshReview.rejectAll",
        "icon": {
          "light": "media/dsh-reject.svg",
          "dark": "media/dsh-reject.svg"
        },
        "category": "dsh",
        "title": "全部撤回"
      },
      {
        "command": "dshReview.reloadSidebar",
        "category": "dsh",
        "title": "重载 dsh 侧栏"
      },
      {
        "command": "dshReview.restartDshBili",
        "icon": "$(zap)",
        "category": "dsh",
        "title": "重启 dsh（bili 环境）"
      },
      {
        "command": "dshReview.browserComment.selftest",
        "category": "dsh",
        "title": "元素批注：探针自检（排障）"
      },
      {
        "command": "dshReview.elementWatcherPing",
        "category": "dsh",
        "title": "排障：元素监听心跳"
      },
      {
        "command": "dshReview.elementStorageProbe",
        "category": "dsh",
        "title": "排障：元素存储探测"
      },
      {
        "command": "dshReview.cdpChipDump",
        "category": "dsh",
        "title": "排障：CDP 元素 chip 快照"
      },
      {
        "command": "dshReview.cdpPing",
        "category": "dsh",
        "title": "排障：CDP 连通性"
      },
      {
        "command": "dshReview.testAutoClose",
        "category": "dsh",
        "title": "排障：自动关闭测试 1"
      },
      {
        "command": "dshReview.testAutoClose2",
        "category": "dsh",
        "title": "排障：自动关闭测试 2"
      },
      {
        "command": "dshReview.testAutoClose3",
        "category": "dsh",
        "title": "排障：自动关闭测试 3"
      },
      {
        "command": "dshReview.testAutoClose4",
        "category": "dsh",
        "title": "排障：自动关闭测试 4"
      }
    ],
    "configuration": {
      "title": "dsh review",
      "properties": {
        "dshReview.webUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "markdownDescription": "URL loaded inside the dsh sidebar webview."
        },
        "dshReview.snippetSend": {
          "type": "string",
          "enum": [
            "pointer",
            "fence"
          ],
          "default": "pointer",
          "markdownDescription": "代码选区 chip 发送模式: pointer = 发送 路径+行号 指针(反引号包裹); fence = 发送整段围栏代码。"
        },
        "dshReview.dshCommand": {
          "type": "string",
          "default": "node ${env:HOME}/.local/bin/dsh --profile web --no-open",
          "markdownDescription": "Shell command for `dsh: Restart dsh`. Leave the default to auto-find `dsh` (`~/.local/bin/dsh` on macOS, `%APPDATA%\\npm\\dsh.cmd` or PATH on Windows). `${env:HOME}` / `${env:USERPROFILE}` expand to the home directory. `--no-open` is always appended if missing."
        },
        "dshReview.dshPort": {
          "type": "number",
          "default": 3080,
          "markdownDescription": "TCP port used to detect/stop the dsh web process."
        },
        "dshReview.authProxyPort": {
          "type": "number",
          "default": 3081,
          "markdownDescription": "Loopback port of the sidebar auth proxy. `dsh web` requires a browser session cookie the sidebar iframe cannot carry, so the sidebar loads `http://127.0.0.1:<this port>` and the extension injects the cookie while forwarding to `dshReview.webUrl`."
        },
        "dshReview.proxyPort": {
          "type": "number",
          "default": 7897,
          "markdownDescription": "Local proxy port for `dsh: Restart dsh (proxy)` (HTTP 127.0.0.1)."
        },
        "dshReview.noProxyExtra": {
          "type": "string",
          "default": "",
          "markdownDescription": "`dsh: Restart dsh (proxy)` 的额外 NO_PROXY 白名单（逗号分隔）：列出的地址绕过本地代理、直连，例如 Tailscale 本机模型地址 `100.97.111.122`。Extra NO_PROXY entries (comma-separated) that bypass the proxy for the proxy restart."
        },
        "dshReview.biliPort": {
          "type": "number",
          "default": 8787,
          "markdownDescription": "`dsh: Restart dsh (bili)` 使用的 bili 代理端口（HTTP 127.0.0.1）。The bili proxy port used by the bili restart (HTTP 127.0.0.1)."
        },
        "dshReview.elementContext.autoCloseTab": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "自动关闭 chip 点击打开的临时 tab(untitled 文档直接丢弃, 不弹保存框). Auto-close the temp tab opened by the element chip after capture."
        },
        "dshReview.elementContext.focusDshAfterCapture": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "捕获元素上下文后把焦点拉回 dsh 侧栏(选元素可能先跳转到了 Copilot). Pull focus back to the dsh sidebar after capturing an element context."
        },
        "dshReview.elementContext.cleanChip": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "自动捕获后把元素 chip 从 Copilot 输入框移除. Remove the element chip from the Copilot input after auto-capture."
        },
        "dshReview.elementContext.clickChips": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "0.1.42 起默认开：点一下聊天里的元素 chip 会把附件文档打开，这是「刚发生了原生批注」的可靠信号（也是页面 URL 的来源），随后我们用不会弹保存提示的方式把它关掉。"
        },
        "dshReview.elementContext.bindDshRemoval": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "0.1.57：双向绑定的回向半边——你在 **dsh 输入框里删掉**某个批注方块时，插件顺手把 Copilot 输入框里对应那行 `@元素 批注` 删掉，VS Code 于是自己把页面上的图钉撤掉（你手工删引用能撤图钉这件事已实测）。关掉就只做单向（批注 → dsh）。0.1.73 起默认关：实测删除动作的两端都在我们进不去的 agent host 里，做不到全同步（用户决定：只保留单向抄送）。"
        },
        "dshReview.elementContext.nativeClearCopilot": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "0.1.53：抄进 dsh 之后，把 Copilot 输入框里那一行 @元素 引用**删掉**（=批注只留在 dsh，不留在 Copilot）。默认关：那是 VS Code 自己的文档，删的动作由你决定。"
        },
        "dshReview.elementContext.nativeToDsh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "0.1.42：把 VS Code 原生「Comment on Elements」的批注直接送进 dsh 输入框。原理：Copilot 输入框本身是一篇插件可读的文档（chatSessionInput:input-0），原生批注会以 `@元素 文字` 的形式写进去，我们读到就走同一条 md 文件 + 文件 chip 的管道（不自动发送）。"
        },
        "dshReview.elementContext.closeNativeDoc": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "0.1.37：VS Code 每次加元素批注都会自己打开一个 untitled 的 Attached Element Context 标签。开着时我们用「存到临时文件 → 关闭 → 删临时文件」的方式把它静默关掉（不会弹保存提示），不往 dsh 插任何东西。"
        },
        "dshReview.elementContext.elementChain": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "0.1.35：旧的「元素搬运」链路（打开附件文档 → 关闭 → 往 dsh 插 element chip）。原生 Comment on Elements + 补丁已经接管，默认关掉，避免重复弹窗。"
        },
        "dshReview.elementContext.image": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "发送时附带元素截图 base64(尽力而为, 取决于 VS Code 是否已落盘, 通常需 ~30s). Best-effort element screenshot (base64) attached when sending to dsh."
        },
        "dshReview.browserComment.nativeBridge": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "0.1.39：把 VS Code 原生「Comment on Elements」的批注也送进 dsh 的那条链路（需要给 VS Code 本体打补丁 tools/patch_comment_hook.py）。实测收端拿不到 agent host 的投递，**默认关闭**；要再试就打开并 `python3 tools/patch_comment_hook.py`。"
        },
        "dshReview.browserComment.sendToDsh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "集成浏览器元素批注: 在每个页面右下角注入 **dsh ✎** 按钮 → 点选元素 → 就地弹批注框 → **Enter** 直接把「元素 + 批注」写成 md 文件并在 dsh 输入框插一个文件 chip（不自动发送、不进 Copilot、不开编辑器）。关闭 = 完全不注入，页面保持原样。需要 CDP（install.sh 已把 `remote-debugging-port` 写进 argv.json，正常启动即可）。Inject the dsh annotation box into integrated-browser pages (Enter → md file + dsh file chip, Copilot untouched)."
        },
        "dshReview.browserComment.commentDir": {
          "type": "string",
          "default": "/tmp/dsh-comments",
          "markdownDescription": "批注 md 文件的存放目录（`~` 会展开成家目录；Linux 上可改成如 `~/.dsh/review/comments`）。Folder that annotation markdown files are written into; dsh inserts a reference to that file."
        },
        "dshReview.browserComment.includeOuterHTML": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "md 文件里带元素 outerHTML / 祖先链（关掉则只带标签、URL、尺寸与 CSS 定位）。Include the element's outerHTML and ancestor chain in the markdown file."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "dshReview.sendSelectionToDsh",
          "when": "editorHasSelection"
        },
        {
          "command": "dshReview.sendTerminalSelectionToDsh",
          "when": "terminalTextSelected"
        },
        {
          "command": "dshReview.sendFileToDsh",
          "when": "filesExplorerFocus && listFocus"
        },
        {
          "command": "dshReview.acceptAll",
          "when": "false"
        },
        {
          "command": "dshReview.rejectAll",
          "when": "false"
        },
        {
          "command": "dshReview.reloadSidebar",
          "when": "false"
        },
        {
          "command": "dshReview.restartDshBili",
          "when": "false"
        },
        {
          "command": "dshReview.browserComment.selftest",
          "when": "false"
        },
        {
          "command": "dshReview.elementWatcherPing",
          "when": "false"
        },
        {
          "command": "dshReview.elementStorageProbe",
          "when": "false"
        },
        {
          "command": "dshReview.cdpChipDump",
          "when": "false"
        },
        {
          "command": "dshReview.cdpPing",
          "when": "false"
        },
        {
          "command": "dshReview.testAutoClose",
          "when": "false"
        },
        {
          "command": "dshReview.testAutoClose2",
          "when": "false"
        },
        {
          "command": "dshReview.testAutoClose3",
          "when": "false"
        },
        {
          "command": "dshReview.testAutoClose4",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "dshReview.acceptAll",
          "when": "dshReview.hasPendingFile",
          "group": "navigation@1"
        },
        {
          "command": "dshReview.rejectAll",
          "when": "dshReview.hasPendingFile",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dshReview.sendSelectionToDsh",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@1"
        }
      ],
      "terminal/context": [
        {
          "command": "dshReview.sendTerminalSelectionToDsh",
          "when": "terminalTextSelected",
          "group": "9_cutcopypaste@1"
        }
      ],
      "view/title": [
        {
          "command": "dshReview.restartDsh",
          "when": "view == dshReview.dshWebview",
          "group": "navigation@1"
        },
        {
          "command": "dshReview.stopDsh",
          "when": "view == dshReview.dshWebview",
          "group": "navigation@2"
        },
        {
          "command": "dshReview.restartDshProxy",
          "when": "view == dshReview.dshWebview",
          "group": "navigation@3"
        },
        {
          "command": "dshReview.restartDshBili",
          "when": "view == dshReview.dshWebview",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "dshReview.sendFileToDsh",
          "group": "6_copypath@10"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dsh",
          "title": "dsh",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dshReview.dshWebview",
          "name": "dsh"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dshReview.openDshSidebar",
        "key": "cmd+alt+d",
        "mac": "cmd+alt+d",
        "win": "ctrl+alt+d",
        "linux": "ctrl+alt+d"
      },
      {
        "command": "dshReview.sendSelectionToDsh",
        "key": "cmd+u",
        "mac": "cmd+u",
        "win": "ctrl+alt+u",
        "linux": "ctrl+alt+u",
        "when": "editorTextFocus && editorHasSelection && !terminalFocus && !terminalEditorFocus"
      },
      {
        "command": "dshReview.sendTerminalSelectionToDsh",
        "key": "cmd+u cmd+u",
        "mac": "cmd+u cmd+u",
        "win": "ctrl+alt+u ctrl+alt+u",
        "linux": "ctrl+alt+u ctrl+alt+u",
        "when": "terminalFocus || terminalEditorFocus"
      },
      {
        "command": "dshReview.sendSelectionToDsh",
        "key": "cmd+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection && !terminalFocus && !terminalEditorFocus"
      },
      {
        "command": "dshReview.sendFileToDsh",
        "key": "cmd+l",
        "mac": "cmd+l",
        "win": "ctrl+alt+l",
        "linux": "ctrl+alt+l",
        "when": "filesExplorerFocus && listFocus && !editorFocus && !terminalFocus && !inputFocus"
      },
      {
        "command": "dshReview.sendFileToDsh",
        "key": "shift+cmd+l",
        "mac": "shift+cmd+l",
        "win": "ctrl+shift+l",
        "linux": "ctrl+shift+l",
        "when": "filesExplorerFocus && listFocus && !editorFocus && !terminalFocus && !inputFocus"
      }
    ]
  },
  "enabledApiProposals": [
    "editorInsets"
  ],
  "dependencies": {
    "ws": "^8.21.3"
  }
}