{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dsh-review-vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=dsn.dsh-review-vscode"
      ],
      "outFiles": ["${workspaceFolder}/extension.js"]
    }
  ]
}
